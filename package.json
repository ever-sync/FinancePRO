  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && npm run build:server && npm run build:trpc-vercel && npm run build:whatsapp-webhook && npm run build:assistant-cron",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:trpc-vercel": "esbuild server/_core/trpc-vercel.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/trpc-vercel.js",
    "build:whatsapp-webhook": "esbuild server/_core/whatsapp-webhook-vercel.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/whatsapp-webhook.js",
    "build:assistant-cron": "esbuild server/_core/assistant-cron-vercel.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/assistant-cron.js",
    "build:vercel": "vite build && npm run build:trpc-vercel && npm run build:whatsapp-webhook && npm run build:assistant-cron",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "prettier --check client/src/App.tsx client/src/components/DashboardLayout.tsx client/src/pages/PlanejamentoFinanceiro.tsx scripts/verify-financial-acceptance.ts server/db.ts server/db/financial-core.ts server/db/whatsapp.ts server/finance server/financial-automation.ts server/financial-automation.test.ts server/financial-core.ts server/n8n-agent.ts server/routers/financial-core.ts server/routers.ts server/routes/assistant-cron.ts server/whatsapp.ts shared/financial-core.ts shared/financial-core.test.ts drizzle/schema.ts n8n/financepro-agent.workflow.json n8n/financepro-automation.workflow.json && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration:financial": "tsx scripts/verify-financial-acceptance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit migrate"
  },
