# Aplicacao e banco
DATABASE_URL=postgresql://usuario:senha@host:5432/financeiro
APP_URL=https://seu-dominio.example.com

# Supabase (as variaveis VITE_* tambem precisam existir durante o build)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima

# Segredos com no minimo 32 caracteres (gere valores diferentes)
CRON_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres
WHATSAPP_WEBHOOK_SECRET=troque-por-outro-segredo-aleatorio-de-64-caracteres

# Orquestracao do agente financeiro no n8n
N8N_AGENT_SECRET=gere-um-terceiro-segredo-aleatorio-de-64-caracteres
N8N_AGENT_WEBHOOK_URL=https://seu-n8n.example.com/webhook/financepro-agent
N8N_AGENT_TIMEOUT_MS=45000

# IA compativel com a API configurada pelo projeto
BUILT_IN_FORGE_API_URL=https://seu-endpoint-de-ia.example.com
BUILT_IN_FORGE_API_KEY=sua-chave-de-ia

# Opcionais
OWNER_OPEN_ID=
OPEN_FINANCE_API_URL=
OPEN_FINANCE_API_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# Somente desenvolvimento local; nunca habilite em producao
ALLOW_PRIVATE_UAZAPI_URLS=false
